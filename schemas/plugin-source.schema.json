{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/SpCoGov/shanten-lens-marketplace/main/schemas/plugin-source.schema.json",
  "title": "Shanten Lens marketplace plugin source",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "repository", "updateManifestUrl", "owners", "status"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$",
      "maxLength": 128
    },
    "repository": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://github\\.com/[^/]+/[^/]+/?$"
    },
    "updateManifestUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://raw\\.githubusercontent\\.com/"
    },
    "owners": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$"}
    },
    "status": {"enum": ["active", "deprecated", "blocked"]},
    "reason": {"type": "string", "maxLength": 500}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["deprecated", "blocked"]}}},
      "then": {"required": ["reason"]}
    }
  ]
}
